---
import { site, micro, mailto } from '../lib/site';
import { tbd } from '../lib/tbd';
interface Props { subject: string }
const { subject } = Astro.props;
const m = mailto(subject);
const linkedin = /TBD/.test(site.contact.linkedin) ? '' : site.contact.linkedin;
---
<div class="contact">
  <p class="lede">{micro.write_to} {m ? <a href={m}>{site.contact.email}</a> : <Fragment set:html={tbd('TBD')} />}. {site.contact.reply}</p>
  <p class="mono">{linkedin ? <a href={linkedin} rel="me">LinkedIn</a> : <Fragment set:html={tbd('LinkedIn: TBD')} />}</p>
</div>
<style>
  .contact { display: grid; gap: 0.75rem; }
  .lede { max-width: 40ch; }
</style>
