---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import { site, identityParts, fmtDate } from '../lib/site';
import { tbd } from '../lib/tbd';
interface Props { lastUpdated: string; entryCount: number }
const { lastUpdated, entryCount } = Astro.props;
const { name, rest } = identityParts();
---
<section class="hero wrap" aria-labelledby="identity">
  <div class="text">
    <h1 id="identity" class="identity"><span class="name">{name}</span> <span class="rest">{rest}</span></h1>
    <nav class="doors" aria-label="Start here">
      <a class="door" href="/lab/"><span class="eyebrow">Clinical AI Lab</span><span class="d">{entryCount} dated entries, each ending in a verdict</span></a>
      <a class="door" href="/advisory/"><span class="eyebrow">Advisory</span><span class="d">Decision memos and diligence reads, fixed fee</span></a>
    </nav>
    <p class="promise lede">{site.position.promise}</p>
    <p class="proof">{site.position.proof}</p>
    <p class="method muted">{site.position.method}</p>
    <p class="updated mono muted">Newest lab entry <time datetime={lastUpdated} set:html={tbd(fmtDate(lastUpdated))} /></p>
  </div>
  <div class="photo">
    <Image src={headshot} alt="Benson S. Hsu" widths={[320, 480, 720]} sizes="(min-width: 900px) 300px, 60vw" format="webp" quality={78} loading="eager" />
  </div>
</section>
<style>
  .hero { display: grid; gap: 1.5rem 3rem; padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2rem, 5vw, 4rem); grid-template-columns: 1fr; grid-template-areas: "text"; }
  @media (min-width: 900px) { .hero { grid-template-columns: minmax(0, 1fr) 300px; grid-template-areas: "text photo"; align-items: start; } }
  .text { grid-area: text; display: grid; gap: 1.25rem; }
  .photo { grid-area: photo; max-width: 300px; display: none; }
  @media (min-width: 900px) { .photo { display: block; } }
  .photo img { border-radius: 3px; width: 100%; height: auto; }
  .identity { font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.25rem); max-width: 28ch; line-height: 1.1; }
  .identity .name { display: block; }
  .identity .rest { display: block; font-size: 0.72em; color: var(--slate); margin-top: 0.35em; font-weight: 300; line-height: 1.2; }
  .doors { display: grid; gap: 0.6rem; grid-template-columns: 1fr; max-width: 40rem; }
  @media (min-width: 540px) { .doors { grid-template-columns: 1fr 1fr; } }
  .door { display: grid; gap: 0.2rem; padding: 0.8rem 0.95rem; border: 1px solid var(--ink); border-radius: 3px; text-decoration: none; background: var(--surface); min-height: 44px; }
  .door:hover { background: var(--ink); color: var(--canvas); }
  .door:hover .eyebrow { color: var(--canvas); }
  .door .d { font-size: 0.92rem; line-height: 1.3; }
  .promise { max-width: 36ch; }
  .proof { max-width: var(--measure); font-size: 1.02rem; }
  .method { font-size: 0.95rem; max-width: 44ch; }
  .updated { font-size: 0.78rem; }
</style>
