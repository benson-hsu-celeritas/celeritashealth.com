---
import { tbd, isTbd } from '../lib/tbd';
import { micro } from '../lib/site';
/** The last thing on every card: the verdict as one word in the serif, then one line of reasoning. No label, no rule, no red. */
interface Props { verdict: string; reasoning?: string; value?: string; compact?: boolean; large?: boolean }
const { verdict, reasoning, value, compact = false, large = false } = Astro.props;
const v = verdict.toLowerCase();
---
<div class:list={['verdict', `v-${v}`, { compact, large }]}>
  <p class="label">
    {isTbd(verdict) ? <span class="vw" set:html={tbd(verdict)} /> : <span class="vw">{verdict}.</span>}
  </p>
  {reasoning && <p class="why" set:html={tbd(reasoning)} />}
  {value && <p class="value"><span class="eyebrow">{micro.worth_label}.</span> <span set:html={tbd(value)} /></p>}
</div>
<style>
  .verdict { display: grid; gap: 0.4rem; padding-top: 0.25rem; }
  .vw { font-family: var(--serif); font-size: var(--s4); line-height: 1; }
  .value { margin-top: 0.35rem; }
  .value .eyebrow { margin-right: 0.3rem; }
  .compact .vw { font-size: var(--s3); }
  .large .vw { font-size: var(--s5); }
</style>
