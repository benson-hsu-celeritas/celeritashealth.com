---
import { tbd, isTbd } from '../lib/tbd';
import { micro } from '../lib/site';
/** The last thing on every card. The verdict word in mono under the single rubric rule that marks a verdict reached. No box. */
interface Props { verdict: string; reasoning?: string; value?: string; compact?: boolean }
const { verdict, reasoning, value, compact = false } = Astro.props;
const v = verdict.toLowerCase();
---
<div class:list={['verdict', `v-${v}`, { compact }]}>
  <p class="label">
    <span class="eyebrow">{micro.verdict_label}</span>
    {isTbd(verdict) ? <span class="vw" set:html={tbd(verdict)} /> : <span class="vw">{verdict}</span>}
  </p>
  {reasoning && <p class="why" set:html={tbd(reasoning)} />}
  {value && <p class="value"><span class="eyebrow">{micro.worth_label}</span> <span set:html={tbd(value)} /></p>}
</div>
<style>
  .verdict { border-top: 2px solid var(--alert); padding-top: 0.6rem; display: grid; gap: 0.45rem; }
  .verdict.v-tbd { border-top-color: var(--rule); }
  .label { display: flex; align-items: baseline; gap: 0.6rem; }
  .vw { font-family: var(--mono); font-weight: 700; font-size: 1rem; letter-spacing: 0.02em; }
  .why { font-size: 0.92rem; }
  .value { font-size: 0.88rem; color: var(--muted); }
  .value .eyebrow { margin-right: 0.3rem; }
  .compact .why, .compact .value { font-size: 0.85rem; }
</style>
