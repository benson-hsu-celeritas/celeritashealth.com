---
/** CH-002: two labelled measurements with their own denominators. Rubric where the lookup caught a wrong identifier. */
const a = { wrong: 458, total: 460 };
const b = { verified: 279, total: 298 };
const W = 300, bh = 14;
---
<figure class="sig fabrication">
  <svg viewBox={`0 0 ${W} 74`} role="img" aria-labelledby="sig-fab-t">
    <title id="sig-fab-t">Two bars. Naive generation: {a.wrong} of {a.total} model-proposed identifiers wrong. Deployed library after omit-then-verify: {b.verified} of {b.total} references verified.</title>
    <text x="0" y="10" class="lbl">Model-proposed identifiers, {a.wrong} of {a.total} wrong</text>
    <rect x="0" y="16" width={W} height={bh} fill="var(--line)" />
    <path class="draw" pathLength="1" d={`M0 ${16 + bh / 2} H${(W * a.wrong) / a.total}`} stroke="var(--alert)" stroke-width={bh} fill="none" />
    <text x="0" y="52" class="lbl">Deployed library after omit-then-verify, {b.verified} of {b.total} verified</text>
    <rect x="0" y="58" width={W} height={bh} fill="var(--line)" />
    <path class="draw" pathLength="1" d={`M0 ${58 + bh / 2} H${(W * b.verified) / b.total}`} stroke="var(--ink)" stroke-width={bh} fill="none" />
  </svg>
</figure>
<style>
  figure { margin: 0; } svg { width: 100%; height: auto; display: block; }
  .lbl { font-family: var(--mono); font-size: 8.5px; fill: var(--muted); }
</style>
