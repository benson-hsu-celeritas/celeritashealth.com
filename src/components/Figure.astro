---
import { existsSync } from 'node:fs';
import { tbd } from '../lib/tbd';
import { micro } from '../lib/site';
/** A drawn figure made in Canva, two exports (light and dark), with its notes beside it in HTML. Until the exports exist the slot shows a visible marker. */
interface Props { figure: { title: string; src_light: string; src_dark: string; width: number; height: number; alt: string; notes: string[] } }
const { figure: f } = Astro.props;
const have = existsSync(`public${f.src_light}`) && existsSync(`public${f.src_dark}`);
---
<figure class="fig">
  <div class="art">
    {have
      ? <><img class="light" src={f.src_light} width={f.width} height={f.height} alt={f.alt} loading="eager" fetchpriority="high" decoding="async" /><img class="dark" src={f.src_dark} width={f.width} height={f.height} alt={f.alt} loading="eager" decoding="async" /></>
      : <p class="mono muted pending" set:html={tbd(micro.figure_pending)} />}
  </div>
  <figcaption>
    <p class="cap"><span class="serif t">{f.title}</span></p>
    <p class="eyebrow">{micro.figure_notes}</p>
    <ol class="notes">{f.notes.map((n) => <li set:html={tbd(n)} />)}</ol>
  </figcaption>
</figure>
<style>
  .fig { margin: 0 0 2rem; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .fig { grid-template-columns: minmax(0, 360px) minmax(0, 1fr); align-items: start; } }
  .art img { width: 100%; max-width: 360px; height: auto; }
  .art .dark { display: none; }
  :global(:root[data-theme="dark"]) .art .light { display: none; }
  :global(:root[data-theme="dark"]) .art .dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .art .light { display: none; }
    :global(:root:not([data-theme="light"])) .art .dark { display: block; }
  }
  @media print { .art .light { display: block !important; } .art .dark { display: none !important; } }
  .pending { padding: 1rem; border: 1px dashed var(--rule); }
  figcaption { display: grid; gap: 0.5rem; font-size: 0.9rem; }
  .cap .t { font-size: 1.05rem; }
  .notes { margin: 0; padding-left: 1.4rem; display: grid; gap: 0.3rem; list-style: decimal; }
  .notes li::marker { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
</style>
