---
import excerpt from '../../content/data/error-log-excerpt.json';
import { tbd, isTbd } from '../lib/tbd';
/** The one reveal on the site (CH-001). Tap a line, use the slider or the arrow keys, or drag the slider, to see what validation caught.
 *  With JavaScript off, every catch is shown. Every TBD in the excerpt is a visible marker. */
const lines = excerpt.excerpt;
const pending = isTbd(excerpt.pathway) || lines.some((l) => isTbd(l.text));
const catches = lines.filter((l) => l.catch).length;
const kindLabel: Record<string, string> = {
  fabricated_identifier: 'Fabricated identifier, caught by the deterministic lookup',
  dose_out_of_range: 'Dose out of range, caught by the range check',
  omission_caught_externally: 'Omission, caught by external comparison',
  unverifiable_not_fabricated: 'Unverifiable, not fabricated',
};
---
<section class="reveal" data-reveal={pending ? undefined : ''} aria-labelledby="reveal-h">
  <h2 id="reveal-h" class="h">What validation caught</h2>
  <p class="intro">A real excerpt from the protocol engine's pathway <span class="mono" set:html={tbd(excerpt.pathway)} />. Move the verification across it to see each catch: a struck identifier, a flagged dose, an omission the model reviewer missed.</p>
  {pending && <p class="pending" set:html={tbd('TBD: the excerpt is pending, verbatim from the deposit. The reveal runs on the structure until then.')} />}
  {!pending && <div class="controls no-print">
    <button type="button" class="btn btn-ghost" data-prev>Previous catch</button>
    <label class="slider">
      <span class="sr-only">Verification position</span>
      <input type="range" min="0" max={lines.length} value={lines.length} step="1" data-pos aria-valuetext="all lines verified" />
    </label>
    <button type="button" class="btn btn-ghost" data-next>Next catch</button>
  </div>}
  <ol class="excerpt" data-lines>
    {lines.map((l, i) => <li class:list={['line', { 'has-catch': !!l.catch }]} data-i={i} data-kind={l.catch?.kind}>
      <button type="button" class="linebtn" data-line>
        <span class="n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="sr-only">Line {i + 1}{l.catch ? `, ${kindLabel[l.catch.kind]}` : ''}: </span>
        <span class="text" set:html={tbd(l.text)} />
      </button>
      {l.catch && <div class="catch">
        <span class="kind mono">{kindLabel[l.catch.kind] ?? l.catch.kind}</span>
        {l.catch.struck && <s class="struck" set:html={tbd(l.catch.struck)} />}
        {l.catch.replacement && <span class="fix" set:html={tbd(l.catch.replacement)} />}
      </div>}
    </li>)}
  </ol>
  {!pending && <p class="mono muted count" data-count aria-live="polite">{catches} catches in {lines.length} lines.</p>}
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-reveal]');
  if (root) {
    const pos = root.querySelector<HTMLInputElement>('[data-pos]')!;
    const lines = Array.from(root.querySelectorAll<HTMLElement>('.line'));
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const catchIdx = lines.filter((l) => l.classList.contains('has-catch')).map((l) => Number(l.dataset.i));
    const set = (v: number, announce = true) => {
      v = Math.max(0, Math.min(lines.length, v));
      pos.value = String(v);
      let shown = 0;
      lines.forEach((l, i) => { const on = i < v; l.classList.toggle('verified', on); if (on && l.classList.contains('has-catch')) shown++; });
      pos.setAttribute('aria-valuetext', v === 0 ? 'nothing verified yet' : v === lines.length ? 'all lines verified' : `${v} of ${lines.length} lines verified`);
      if (announce) count.textContent = `${shown} of ${catchIdx.length} catches shown.`;
    };
    pos.addEventListener('input', () => set(Number(pos.value)));
    root.querySelector('[data-next]')!.addEventListener('click', () => { const v = Number(pos.value); const n = catchIdx.find((i) => i + 1 > v); set(n === undefined ? lines.length : n + 1); });
    root.querySelector('[data-prev]')!.addEventListener('click', () => { const v = Number(pos.value); const p = [...catchIdx].reverse().find((i) => i + 1 < v); set(p === undefined ? 0 : p + 1); });
    lines.forEach((l) => l.querySelector('[data-line]')!.addEventListener('click', () => set(Number(l.dataset.i) + 1)));
    root.classList.add('live');
    set(0, false);
  }
</script>
<style>
  .reveal { display: grid; gap: 1rem; }
  .h { font-size: 1.6rem; }
  .pending { font-size: 0.9rem; }
  .controls { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .no-js .controls { display: none; }
  .slider { flex: 1 1 200px; display: flex; }
  input[type="range"] { width: 100%; accent-color: var(--ink); min-height: 44px; }
  .excerpt { list-style: none; padding: 0; margin: 0; border: 1px solid var(--line); background: var(--surface); border-radius: 3px; counter-reset: l; }
  .line { border-top: 1px solid var(--line); }
  .line:first-child { border-top: 0; }
  .linebtn { all: unset; display: grid; grid-template-columns: 2.2rem 1fr; gap: 0.5rem; width: 100%; box-sizing: border-box; padding: 0.7rem 0.9rem; cursor: pointer; font-family: var(--serif); font-size: 1rem; line-height: 1.45; }
  .no-js .linebtn { cursor: default; }
  .linebtn:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .n { color: var(--muted); padding-top: 0.15rem; }
  .catch { margin: 0 0.9rem 0.8rem 3.6rem; display: grid; gap: 0.25rem; font-size: 0.9rem; border-left: 2px solid var(--alert); padding-left: 0.7rem; }
  .kind { color: var(--alert); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .struck { color: var(--muted); text-decoration-color: var(--alert); text-decoration-thickness: 2px; }
  /* Live: catches hidden until verified; the line text is struck when verification reaches a fabricated or out-of-range item. */
  .live .line.has-catch:not(.verified) .catch { display: none; }
  .live .line.has-catch.verified .text { background: color-mix(in oklab, var(--alert) 10%, transparent); }
  .live .line.verified .n { color: var(--ink); }
</style>
