---
import Wordmark from './Wordmark.astro';
import { site, micro } from '../lib/site';
import { tbd } from '../lib/tbd';
/** The colophon: every item the brief lists for the footer, as short rows, and the build date. The header is the nav. */
const c = site.contact;
const email = /TBD/.test(c.email) ? null : c.email;
const linkedin = /TBD/.test(c.linkedin) ? null : c.linkedin;
const built = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="mark"><Wordmark width="220px" descriptor defs={false} /></div>
    <div class="rows">
      <p class="mono row1">{email ? <a href={`mailto:${email}`}>{email}</a> : <Fragment set:html={tbd('Email: TBD')} />} · {linkedin ? <a href={linkedin} rel="me">LinkedIn</a> : <Fragment set:html={tbd('LinkedIn: TBD')} />}</p>
      <p class="row2">{site.disclosure} {site.aequitas_separation} <span set:html={tbd(site.employers_line)} /></p>
      <p class="row3 muted">© {new Date().getFullYear()} Celeritas Health LLC. {micro.footer_copyright} <a href="/about/#disclosures">{micro.footer_disclosures}</a>.</p>
      <p class="row4 muted">{micro.colophon} {built}.</p>
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 2rem 3rem; font-size: var(--s1); }
  .grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .grid { grid-template-columns: 240px minmax(0, 1fr); align-items: start; } }
  .rows { display: grid; gap: 0.6rem; }
  .rows p { max-width: 70ch; }
  .row3, .row4 { font-size: var(--s1); }
  .row4 { font-style: italic; }
</style>
