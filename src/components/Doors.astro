---
import { site, type Entry, findEntry, entryHref } from '../lib/site';
import { tbd } from '../lib/tbd';
/** Who this is for: three ruled rows by buyer, each naming where to start. A draft never becomes a dead door. */
interface Props { entries: Entry[] }
const { entries } = Astro.props;
const tierFor: Record<string, string> = { 'CH-011': 'tier-2', 'CH-012': 'tier-2', method: 'method' };
const doors = site.doors as Array<{ audience: string; read_first: string; line: string; link_label: string; sample_label?: string }>;
---
<ul class="doors">
  {doors.map((d) => {
    const e = d.read_first === 'method' ? undefined : findEntry(entries, d.read_first);
    const ready = e && !e.data.draft;
    return <li class="row">
      <p class="aud mono">{d.audience}</p>
      <p class="line">{d.line}</p>
      <p class="read mono">
        {d.read_first === 'method' && <a href="/advisory/#method">{d.link_label}</a>}
        {ready && <a href={entryHref(e!)}>{d.link_label}: {e!.data.id}</a>}
        {e && !ready && <><a href={`/advisory/#${tierFor[d.read_first]}`}>{d.link_label}</a> <span title={e.data.id} set:html={tbd(`${d.sample_label}: TBD`)} /></>}
      </p>
    </li>;
  })}
</ul>
<style>
  .doors { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .row { display: grid; gap: 0.35rem 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--line); grid-template-columns: 1fr; }
  @media (min-width: 760px) { .row { grid-template-columns: 11rem minmax(0, 1fr) 14rem; align-items: baseline; } }
  .aud { color: var(--ink); font-weight: 600; }
  .line { font-size: 0.98rem; max-width: 52ch; }
  .read { font-size: 0.78rem; }
  .read a { display: inline-block; padding: 0.4rem 0; }
  .read span { display: inline-block; margin-left: 0.5rem; }
</style>
