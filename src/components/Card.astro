---
import StageRail from './StageRail.astro';
import VerdictChip from './VerdictChip.astro';
import Signature from './Signature.astro';
import { micro, fmtDate, entryHref, type Entry } from '../lib/site';
import { tbd } from '../lib/tbd';
/** A published entry. The page header carries the identity line once; the card carries the work: drawing, numbers, stages addressed, verdict. */
interface Props { entry: Entry; heading?: 'h2' | 'h3' }
const { entry, heading: H = 'h3' } = Astro.props;
const d = entry.data;
const href = entryHref(entry);
const drawn = ['pathways', 'fabrication', 'access-gap', 'citation-trace', 'subtraction', 'agent-flow'].includes(d.signature);
const finding = drawn ? d.numbers : d.numbers.slice(1);
---
<article class="card" data-type={d.type} data-stages={d.stages.join(' ')} data-entry={d.id} id={d.id.toLowerCase()}>
  <header class="meta mono">
    <span class="id">{d.id}</span>
    <span class="date" set:html={tbd(fmtDate(d.date))} />
    <span class="type">{d.type}</span>
  </header>
  <H class="title"><a href={href} set:html={tbd(d.title)} /></H>
  <div class="sigwrap"><Signature kind={d.signature} numbers={d.numbers} /></div>
  <p class="status mono muted" set:html={tbd(d.status)} />
  {finding.length > 0 && <ol class="finding">{finding.map((n) => <li set:html={tbd(n)} />)}</ol>}
  <StageRail lit={d.stages} compact />
  <VerdictChip verdict={d.verdict} reasoning={d.reasoning} compact />
  <p class="more"><a href={href}>{micro.read_entry}</a>{d.doi && <> · <a href={`https://doi.org/${d.doi}`} rel="noopener">{micro.preprint}</a></>}</p>
</article>
<style>
  .card { background: var(--surface); border-top: 2px solid var(--ink); padding: 1rem 1.1rem 1.1rem; display: grid; gap: 0.8rem; align-content: start; }
  .meta { display: flex; gap: 0.75rem; flex-wrap: wrap; color: var(--muted); }
  .id { color: var(--ink); font-weight: 600; }
  .title { font-size: 1.3rem; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-decoration-color: var(--rule); }
  .finding { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; font-size: 0.92rem; counter-reset: f; }
  .finding li { counter-increment: f; padding-left: 1.4rem; position: relative; }
  .finding li::before { content: counter(f); position: absolute; left: 0; top: 0.15em; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .more { font-size: 0.88rem; }
</style>
