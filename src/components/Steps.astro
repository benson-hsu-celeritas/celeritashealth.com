---
import { site } from '../lib/site';
---
<ol class="steps">
  {site.engagement_steps.map((s, i) => <li><span class="n mono">0{i + 1}</span><span>{s}</span></li>)}
</ol>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; background: var(--line); grid-template-columns: 1fr; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  li { background: var(--canvas); padding: 1rem 1rem 1rem 0; display: grid; gap: 0.4rem; font-family: var(--serif); font-size: 1.15rem; }
  @media (min-width: 760px) { li { padding-inline: 1rem; } li:first-child { padding-left: 0; } }
  .n { color: var(--muted); }
</style>
