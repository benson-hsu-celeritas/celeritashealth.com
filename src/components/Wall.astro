---
import Card from './Card.astro';
import { site, stages, micro, headings, fmtDate, entryHref, type Entry } from '../lib/site';
import { tbd, isTbd } from '../lib/tbd';
/** The Lab: a flowsheet (every entry by date, stage and verdict) that doubles as the index, then the wall of published cards.
 *  Drafts are greyed rows in the flowsheet, never cards. Filters hide without JavaScript; the flowsheet and every card stay. */
interface Props { entries: Entry[] }
const { entries: all } = Astro.props;
const entries = all.filter((e) => !e.data.draft);
const drafts = all.filter((e) => e.data.draft);
const types = site.card_types as string[];
const count = (t: string) => entries.filter((e) => e.data.type === t).length;
const draftCount = (t: string) => drafts.filter((e) => e.data.type === t).length;
---
<div class="wall" data-wall>
  <form class="filters no-print" aria-label={micro.filter_entries} onsubmit="return false">
    <fieldset>
      <legend class="eyebrow">{micro.filter_type}</legend>
      <button type="button" data-f-type="" aria-pressed="true">{micro.filter_all} <span class="n">{entries.length}</span></button>
      {types.filter((t) => count(t) > 0).map((t) => <button type="button" data-f-type={t} aria-pressed="false">{t} <span class="n">{count(t)}</span></button>)}
    </fieldset>
    <fieldset>
      <legend class="eyebrow">{micro.filter_stage}</legend>
      {stages.map((s) => <button type="button" data-f-stage={s.key} aria-pressed="false">{s.name}</button>)}
    </fieldset>
    <p class="status mono muted" data-f-status aria-live="polite"></p>
  </form>

  <table class="flowsheet">
    <caption class="sr-only">{micro.flowsheet_caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="mono">{micro.col_date}</th>
        <th scope="col" class="mono">{micro.col_id}</th>
        <th scope="col">{micro.col_entry}</th>
        {stages.map((s) => <th scope="col" class="st">{s.name}</th>)}
        <th scope="col" class="mono">{micro.col_verdict}</th>
      </tr>
    </thead>
    <tbody>
      {entries.map((e) => <tr class="frow" data-type={e.data.type} data-stages={e.data.stages.join(' ')} data-entry={e.data.id}>
        <td class="mono date" set:html={tbd(fmtDate(e.data.date))} />
        <td class="mono id">{e.data.id}</td>
        <td class="t"><a href={`#${e.data.id.toLowerCase()}`} set:html={tbd(e.data.title)} /></td>
        {stages.map((s) => { const on = e.data.stages.includes(s.key); return <td class:list={['st', { on }]} data-label={s.name}><span class="sq" aria-hidden="true"></span><span class="sr-only">{on ? micro.addressed : micro.not_addressed}</span></td>; })}
        <td class="v"><span class="vw">{e.data.verdict}</span></td>
      </tr>)}
    </tbody>
    {drafts.length > 0 && <tbody class="drafts">
      <tr class="sub"><th scope="rowgroup" colspan={stages.length + 4}><span class="serif">{headings.lab_in_progress}</span> <span class="mono muted">({drafts.length})</span></th></tr>
      {drafts.map((e) => <tr class="frow draft" data-type={e.data.type} data-stages={e.data.stages.join(' ')} data-entry={e.data.id}>
        <td class="mono date" set:html={tbd(fmtDate(e.data.date))} />
        <td class="mono id">{e.data.id}</td>
        <td class="t"><a href={entryHref(e)} set:html={tbd(e.data.title)} /></td>
        {stages.map((s) => { const on = e.data.stages.includes(s.key); return <td class:list={['st', { on }]} data-label={s.name}><span class="sq" aria-hidden="true"></span><span class="sr-only">{on ? micro.addressed : micro.not_addressed}</span></td>; })}
        <td class="v mono muted">{isTbd(e.data.verdict) ? <span set:html={tbd(e.data.verdict)} /> : <>{e.data.verdict} <span class="prov">{micro.provisional}</span></>}</td>
      </tr>)}
    </tbody>}
  </table>

  <div class="grid" data-cards>
    {entries.map((e) => <Card entry={e} heading="h2" />)}
  </div>
  <p class="empty mono muted" data-f-empty hidden>{micro.no_match} {types.filter((t) => count(t) === 0 && draftCount(t) > 0).map((t) => `${t}: ${draftCount(t)} ${micro.in_preparation_note}.`).join(' ')}</p>
</div>
<script>
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  if (wall) {
    const cards = Array.from(wall.querySelectorAll<HTMLElement>('[data-cards] > article'));
    const rows = Array.from(wall.querySelectorAll<HTMLElement>('tr.frow'));
    const typeBtns = Array.from(wall.querySelectorAll<HTMLButtonElement>('[data-f-type]'));
    const stageBtns = Array.from(wall.querySelectorAll<HTMLButtonElement>('[data-f-stage]'));
    const status = wall.querySelector<HTMLElement>('[data-f-status]')!;
    const empty = wall.querySelector<HTMLElement>('[data-f-empty]')!;
    let type = '';
    const stagesOn = new Set<string>();
    const match = (el: HTMLElement) => {
      const okT = !type || el.dataset.type === type;
      const cs = (el.dataset.stages || '').split(' ');
      return okT && (stagesOn.size === 0 || [...stagesOn].every((s) => cs.includes(s)));
    };
    const apply = () => {
      let n = 0;
      for (const c of cards) { c.hidden = !match(c); if (!c.hidden) n++; }
      for (const r of rows) r.hidden = !match(r);
      empty.hidden = n > 0;
      const parts = [type || 'all types', ...[...stagesOn].map((s) => s.replace(/-/g, ' '))];
      status.textContent = `Showing ${n} of ${cards.length} entries (${parts.join(', ')}), newest first.`;
    };
    typeBtns.forEach((b) => b.addEventListener('click', () => {
      type = b.dataset.fType || '';
      typeBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    stageBtns.forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.fStage!;
      const on = !stagesOn.has(k);
      on ? stagesOn.add(k) : stagesOn.delete(k);
      b.setAttribute('aria-pressed', String(on));
      apply();
    }));
  }
</script>
<style>
  :global(.no-js) .filters { display: none; }
  .filters { display: grid; gap: 0.5rem; margin-bottom: 1.25rem; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0 1.1rem; align-items: baseline; }
  legend { float: left; margin-right: 0.8rem; padding: 0; }
  button { font: inherit; font-family: var(--mono); font-size: var(--s1); letter-spacing: 0.02em; min-height: 36px; padding: 0.3rem 0; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted); cursor: pointer; }
  button:hover { color: var(--ink); }
  button[aria-pressed="true"] { color: var(--ink); border-bottom-color: var(--ink); }
  button:disabled { color: var(--muted); opacity: 0.6; cursor: not-allowed; }
  .n { opacity: 0.8; margin-left: 0.15rem; }
  .status { margin-top: 0.25rem; }
  .status:empty { display: none; }

  .flowsheet { width: 100%; border-collapse: collapse; margin-bottom: 2.5rem; font-size: 1rem; }
  .flowsheet th { text-align: left; font-weight: 400; color: var(--muted); padding: 0.4rem 0.6rem 0.4rem 0; border-bottom: 1px solid var(--ink); white-space: nowrap; }
  .flowsheet th.mono, .flowsheet td.mono { font-size: var(--s1); }
  .flowsheet td { padding: 0.6rem 0.6rem 0.6rem 0; border-bottom: 1px solid var(--line); vertical-align: baseline; }
  .flowsheet td.id { font-weight: 600; color: var(--ink); white-space: nowrap; }
  .flowsheet td.date { white-space: nowrap; color: var(--muted); }
  .flowsheet td.t a { text-decoration: none; font-family: var(--serif); font-size: 1rem; }
  .flowsheet td.t a:hover { text-decoration: underline; text-decoration-color: var(--rule); }
  .flowsheet .st { text-align: center; }
  .flowsheet th.st { text-align: center; font-family: var(--sans); font-size: var(--s1); }
  .sq { display: inline-block; width: 8px; height: 8px; border: 1px solid var(--muted); box-sizing: border-box; vertical-align: middle; }
  .st.on .sq { background: var(--ink); border-color: var(--ink); }
  .v .vw { font-family: var(--serif); font-size: 1rem; display: inline-block; }
  .drafts td { color: var(--muted); }
  .drafts td.id { color: var(--muted); }
  .drafts .sq { opacity: 0.6; }
  .drafts .v { font-size: var(--s1); }
  .prov { font-size: var(--s1); }
  .sub th { padding-top: 1.4rem; border-bottom: 1px solid var(--line); color: var(--ink); font-size: 1rem; }
  @media (max-width: 759px) {
    .flowsheet thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
    .flowsheet tr.frow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.2rem 0.5rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
    .flowsheet tr.sub { display: block; }
    .flowsheet td { border: 0; padding: 0; }
    .flowsheet td.id { grid-column: 1 / 3; }
    .flowsheet td.v { grid-column: 3 / 5; justify-self: end; }
    .flowsheet td.date { grid-column: 1 / 5; }
    .flowsheet td.t { grid-column: 1 / 5; padding: 0.1rem 0 0.3rem; }
    .flowsheet td.st { text-align: left; font-family: var(--sans); font-size: var(--s1); color: var(--muted); }
    .flowsheet td.st.on { color: var(--ink); }
    .flowsheet td.st::after { content: attr(data-label); margin-left: 0.35rem; }
    .flowsheet .drafts td.st { display: none; }
    .flowsheet .drafts tr.frow { padding: 0.5rem 0; }
  }
  .grid { display: grid; gap: 2.5rem 2rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .empty { margin-top: 1rem; }
</style>
