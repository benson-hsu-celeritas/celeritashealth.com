---
import { stages, micro, type StageKey } from '../lib/site';
/** The one structural device: four stages, a filled square where addressed. Full rail on write-ups; on cards only the stages the entry addresses. */
interface Props { lit: StageKey[]; size?: 'sm' | 'md'; links?: boolean; compact?: boolean }
const { lit, size = 'sm', links = false, compact = false } = Astro.props;
const shown = compact ? stages.filter((s) => lit.includes(s.key)) : stages;
---
<ol class:list={['rail', size, { compact }]} aria-label={micro.stages_addressed}>
  {shown.map((s) => {
    const on = lit.includes(s.key);
    const inner = <><span class="sq" aria-hidden="true"></span><span class="lbl">{s.name}</span>{!compact && <span class="sr-only"> ({on ? micro.addressed : micro.not_addressed})</span>}</>;
    return <li class:list={{ on }}>{links ? <a href={`/advisory/#${s.key}`}>{inner}</a> : inner}</li>;
  })}
</ol>
<style>
  .rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, max-content); justify-content: space-between; gap: 0.4rem 0.75rem; }
  .rail.compact { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 0.3rem 1.1rem; }
  .lbl { white-space: nowrap; }
  @media (max-width: 340px) { .rail:not(.compact) { grid-template-columns: repeat(2, max-content); } }
  .rail li { position: relative; padding-left: 0.85rem; color: var(--muted); font-family: var(--sans); font-size: var(--s1); line-height: 1.3; }
  .rail li.on { color: var(--ink); }
  .rail li a { text-decoration: none; display: block; color: inherit; }
  .rail li a:hover .lbl { text-decoration: underline; }
  .sq { position: absolute; top: 0.3em; left: 0; width: 7px; height: 7px; border: 1px solid var(--muted); box-sizing: border-box; }
  .on .sq { background: var(--ink); border-color: var(--ink); }
  .md li { font-size: var(--s1); }
</style>
