---
import { stages, micro, type StageKey } from '../lib/site';
/** The one structural device: four stages, a filled square where addressed. Labels always visible. */
interface Props { lit: StageKey[]; size?: 'sm' | 'md'; links?: boolean }
const { lit, size = 'sm', links = false } = Astro.props;
---
<ol class:list={['rail', size]} aria-label={micro.stages_addressed}>
  {stages.map((s) => {
    const on = lit.includes(s.key);
    const inner = <><span class="sq" aria-hidden="true"></span><span class="lbl">{s.name}</span><span class="sr-only"> ({on ? micro.addressed : micro.not_addressed})</span></>;
    return <li class:list={{ on }}>{links ? <a href={`/advisory/#${s.key}`}>{inner}</a> : inner}</li>;
  })}
</ol>
<style>
  .rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem; }
  .rail li { position: relative; padding-left: 0.85rem; color: var(--muted); font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.3; }
  .rail li.on { color: var(--ink); }
  .rail li a { text-decoration: none; display: block; color: inherit; }
  .rail li a:hover .lbl { text-decoration: underline; }
  .sq { position: absolute; top: 0.25em; left: 0; width: 7px; height: 7px; border: 1px solid var(--muted); box-sizing: border-box; }
  .on .sq { background: var(--ink); border-color: var(--ink); }
  .md li { font-size: 0.72rem; }
</style>
