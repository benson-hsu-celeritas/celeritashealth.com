---
import { stages, type StageKey } from '../lib/site';
/** The one structural device: four stages, lit where addressed. */
interface Props { lit: StageKey[]; size?: 'sm' | 'md'; links?: boolean }
const { lit, size = 'sm', links = false } = Astro.props;
---
<ol class:list={['rail', size]} aria-label="Stages addressed">
  {stages.map((s) => {
    const on = lit.includes(s.key);
    const inner = <><span class="dot" aria-hidden="true"></span><span class="lbl">{s.name}</span>{on && <span class="sr-only"> (addressed)</span>}</>;
    return <li class:list={{ on }}>{links ? <a href={`/advisory/#${s.key}`}>{inner}</a> : inner}</li>;
  })}
</ol>
<style>
  .rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .rail li { position: relative; padding-top: 0.5rem; border-top: 2px solid var(--line); color: var(--muted); font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .rail li.on { border-top-color: var(--ink); color: var(--ink); }
  .rail li a { text-decoration: none; display: block; }
  .dot { position: absolute; top: -4px; left: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--line); }
  .on .dot { background: var(--ink); }
  .md li { font-size: 0.75rem; padding-top: 0.65rem; }
</style>
