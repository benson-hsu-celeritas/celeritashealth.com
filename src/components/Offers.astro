---
import { site, micro, headings } from '../lib/site';
/** Offers as one table: for whom, turnaround, what is included. No prices. The tier 1 credit is its own row under the red-flag read; the fee line sits beneath. */
const offers = site.offers as Array<{ tier: string; name: string; for: string; scope: string; turnaround?: string; note?: string }>;
---
<table class="offers">
  <caption class="sr-only">{headings.advisory_offers}</caption>
  <thead>
    <tr><th scope="col">{micro.tier}</th><th scope="col">{micro.offers_for}</th><th scope="col">{micro.offers_turnaround}</th><th scope="col">{micro.offers_includes}</th></tr>
  </thead>
  <tbody>
    {offers.map((o) => <>
    <tr id={o.tier === 'project' ? 'project' : `tier-${o.tier}`}>
      <th scope="row"><span class="mono muted tier">{o.tier === 'project' ? micro.project : `${micro.tier} ${o.tier}`}</span><span class="name">{o.name}</span></th>
      <td data-label={micro.offers_for}>{o.for}</td>
      <td data-label={micro.offers_turnaround} class="ta">{o.turnaround && <span class="mono">{o.turnaround}</span>}</td>
      <td data-label={micro.offers_includes}>{o.scope}</td>
    </tr>
    {o.note && <tr class="credit"><th scope="row"><span class="name">{micro.credit}</span></th><td colspan="3">{o.note}</td></tr>}
    </>)}
  </tbody>
</table>
<p class="fee lede">{site.fee_line}</p>
<style>
  .offers { width: 100%; border-collapse: collapse; font-size: 1rem; }
  .offers thead th { text-align: left; font-weight: 400; color: var(--muted); font-size: var(--s1); padding: 0 0.8rem 0.5rem 0; border-bottom: 1px solid var(--ink); font-family: var(--sans); }
  .offers tbody th, .offers td { text-align: left; vertical-align: top; padding: 0.9rem 0.8rem 0.9rem 0; border-bottom: 1px solid var(--line); font-weight: 400; }
  .offers tbody th { display: grid; gap: 0.15rem; min-width: 11rem; }
  .name { font-family: var(--serif); font-size: var(--s3); line-height: 1.2; }
  .ta { white-space: nowrap; }
  .credit th .name { font-size: 1rem; }
  .credit td { color: var(--muted); }
  .fee { margin-top: 1.5rem; max-width: 50ch; }
  @media (max-width: 759px) {
    .offers thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
    .offers tr { display: grid; gap: 0.3rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
    .offers tbody th, .offers td { border: 0; padding: 0; }
    .offers td::before { content: attr(data-label); display: block; font-family: var(--sans); font-size: var(--s1); color: var(--muted); margin-top: 0.3rem; }
    .ta { white-space: normal; }
  }
</style>
