---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import { site, headings, micro } from '../lib/site';
import { aboutSections, recordRows } from '../lib/about';
import { tbd } from '../lib/tbd';
/** About: the two-minute story in the owner's own voice, then the record as a dated ledger (year, event, number, stage in the margin), papers, disclosures, contact. */
const sections = aboutSections();
const by = (h: string) => sections.find((s) => s.heading.toLowerCase().startsWith(h.toLowerCase()));
const story = by('The two-minute story');
const papers = by('Papers'), disclosures = by('Disclosures');
const record = recordRows();
---
<BaseLayout title={site.seo.about_title} description={site.seo.about_description} og="about">
  <article class="wrap about">
    <header class="head">
      <div class="photo"><Image src={headshot} alt="Benson S. Hsu" widths={[240, 480]} sizes="(min-width: 760px) 220px, 40vw" format="webp" quality={78} loading="eager" /></div>
      <div class="id">
        <h1>{site.signature_block.name}</h1>
        <p class="line muted">{site.signature_block.line}</p>
        <p class="proofline">{site.position.proof}</p>
      </div>
    </header>
    {story && <section class="section" id="story" aria-labelledby="story-h"><h2 id="story-h">{story.heading}</h2><div class="prose story" set:html={story.html} /></section>}
    <section class="section ruled" id="record" aria-labelledby="record-h">
      <h2 id="record-h">{headings.about_bio}</h2>
      {record.lede && <p class="lede-r muted" set:html={tbd(record.lede)} />}
      <ol class="record">
        {record.rows.map((r) => <li class="row">
          <p class="when mono" set:html={tbd(r.when)} />
          <p class="what" set:html={tbd(r.what)} />
          <p class="stage muted">{r.stage}</p>
        </li>)}
      </ol>
    </section>
    {papers && <section class="section" id="papers" aria-labelledby="papers-h"><h2 id="papers-h">{papers.heading}</h2><div class="prose" set:html={papers.html} /></section>}
    {disclosures && <section class="section" id="disclosures" aria-labelledby="disc-h"><h2 id="disc-h">{disclosures.heading}</h2><div class="prose" set:html={disclosures.html} /></section>}
    <section class="section" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">{headings.advisory_contact}</h2>
      <Contact subject="Hello" />
      <p class="muted cv">{micro.cv}: <mark class="tbd" title="Placeholder: not yet supplied">TBD</mark></p>
    </section>
  </article>
</BaseLayout>
<style>
  .about { padding-top: clamp(1.5rem, 4vw, 3rem); }
  .head { display: grid; gap: 1.25rem 2rem; grid-template-columns: minmax(0, 1fr); align-items: end; max-width: 60rem; }
  @media (min-width: 760px) { .head { grid-template-columns: 220px minmax(0, 1fr); } }
  .photo { width: min(40vw, 220px); }
  .id { display: grid; gap: 0.5rem; }
  h1 { font-size: var(--s5); }
  .proofline { font-family: var(--serif); font-size: var(--s3); line-height: 1.35; max-width: 44ch; margin-top: 0.5rem; }
  h2 { font-size: var(--s4); margin-bottom: 1rem; }
  .story :global(p) { font-family: var(--serif); font-size: var(--s3); line-height: 1.4; max-width: var(--measure); }
  .story :global(blockquote) { display: none; }
  .lede-r { margin-bottom: 1.5rem; }
  .record { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; max-width: 56rem; }
  .row { display: grid; gap: 0.15rem 1.5rem; grid-template-columns: 1fr; grid-template-areas: "when" "what" "stage"; }
  @media (min-width: 760px) { .row { grid-template-columns: 8rem minmax(0, 1fr) 7rem; grid-template-areas: "when what stage"; align-items: baseline; } }
  .when { grid-area: when; color: var(--ink); white-space: nowrap; }
  .what { grid-area: what; max-width: var(--measure); }
  .stage { grid-area: stage; font-size: var(--s1); }
  .cv { margin-top: 1rem; font-size: var(--s1); }
</style>
