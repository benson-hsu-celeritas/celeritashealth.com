---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import StageRail from '../components/StageRail.astro';
import { site, stages, headings, micro } from '../lib/site';
import { aboutSections } from '../lib/about';
import { tbd } from '../lib/tbd';
const sections = aboutSections();
const by = (h: string) => sections.find((s) => s.heading.toLowerCase().startsWith(h.toLowerCase()));
const story = by('The two-minute story');
const stageSecs = stages.map((s) => ({ s, sec: by(s.name) }));
const now = by('Now'), papers = by('Papers'), evidence = by('For medical affairs readers'), disclosures = by('Disclosures');
---
<BaseLayout title={site.seo.about_title} description={site.seo.about_description} og="about">
  <article class="wrap about">
    <header class="head">
      <div class="photo"><Image src={headshot} alt="Benson S. Hsu" widths={[160, 320]} sizes="96px" format="webp" quality={78} /></div>
      <h1>{site.signature_block.name}</h1>
      <p class="line muted">{site.signature_block.line}</p>
    </header>
    {story && <section class="section" id="story" aria-labelledby="story-h"><h2 id="story-h">{story.heading}</h2><div class="prose story" set:html={story.html} /></section>}
    <section class="section" id="bio" aria-labelledby="bio-h">
      <h2 id="bio-h">{headings.about_bio}</h2>
      <nav class="railnav" aria-label={micro.bio_nav}>
        <ol class="rail md">
          {stages.map((s) => <li class="on"><a href={`#bio-${s.key}`}><span class="sq" aria-hidden="true"></span><span class="lbl">{s.name}</span></a></li>)}
        </ol>
      </nav>
      <div class="stages">
        {stageSecs.map(({ s, sec }) => sec && <section class="stage" id={`bio-${s.key}`} aria-labelledby={`bio-${s.key}-h`}>
          <h3 id={`bio-${s.key}-h`}>{s.name}</h3>
          <div class="prose" set:html={sec.html} />
        </section>)}
      </div>
    </section>
    {now && <section class="section" id="now" aria-labelledby="now-h"><h2 id="now-h">{now.heading}</h2><div class="prose" set:html={now.html} /></section>}
    {papers && <section class="section" id="papers" aria-labelledby="papers-h"><h2 id="papers-h">{papers.heading}</h2><div class="prose" set:html={papers.html} /></section>}
    {evidence && <section class="section" id="evidence" aria-labelledby="evidence-h"><h2 id="evidence-h">{evidence.heading}</h2><div class="prose" set:html={evidence.html} /></section>}
    {disclosures && <section class="section" id="disclosures" aria-labelledby="disc-h"><h2 id="disc-h">{disclosures.heading}</h2><div class="prose" set:html={disclosures.html} /></section>}
    <p class="proofline lede">{site.position.proof}</p>
    <section class="section" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">{headings.advisory_contact}</h2>
      <Contact subject="Hello" />
      <p class="mono muted cv">{micro.cv}: <mark class="tbd" title="Placeholder: not yet supplied">TBD</mark></p>
    </section>
  </article>
</BaseLayout>
<style>
  .about { padding-top: clamp(1.5rem, 4vw, 3rem); }
  .head { display: grid; gap: 0.15rem 1rem; grid-template-columns: 96px minmax(0, 1fr); grid-template-areas: "p h" "p l"; align-items: center; }
  .photo { grid-area: p; width: 96px; }
  h1 { grid-area: h; font-size: 1.35rem; font-family: var(--sans); font-weight: 500; }
  .line { grid-area: l; font-size: 0.95rem; }
  h2 { font-size: clamp(1.3rem, 1rem + 1.2vw, 1.8rem); margin-bottom: 1rem; }
  .story :global(p) { font-family: var(--serif); font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem); line-height: 1.4; max-width: 60ch; }
  .story :global(blockquote) { display: none; }
  .railnav { margin-bottom: 1.5rem; max-width: 40rem; }
  .rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem; }
  .rail li { position: relative; padding-left: 0.85rem; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .rail a { text-decoration: none; display: inline-block; padding: 0.4rem 0; }
  .rail a:hover .lbl { text-decoration: underline; }
  .sq { position: absolute; top: 0.75em; left: 0; width: 7px; height: 7px; background: var(--ink); }
  .stages { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .stages { grid-template-columns: 1fr 1fr; } }
  .stage { display: grid; gap: 0.75rem; align-content: start; scroll-margin-top: 1rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .stage h3 { font-size: 1.4rem; }
  .proofline { margin-top: 2.5rem; max-width: 40ch; }
  .cv { margin-top: 1rem; }
</style>
