---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MethodAlgorithm from '../components/MethodAlgorithm.astro';
import Ledger from '../components/Ledger.astro';
import Doors from '../components/Doors.astro';
import { site, headings, publishedEntries, allEntries, monthRange } from '../lib/site';
const published = await publishedEntries();
const all = await allEntries();
const newest = published.slice(0, 6);
---
<BaseLayout title={site.seo.home_title} description={site.seo.home_description} home og="home">
  <Hero newest={published[0]} count={published.length} range={monthRange(published)} />
  <MethodAlgorithm />
  <Ledger entries={newest} />
  <section class="section" aria-labelledby="pivot-h">
    <div class="wrap" data-rise>
      <h2 id="pivot-h" class="h2">{headings.home_pivot}</h2>
      <p class="story serif">{site.pivot_story.join(' ')}</p>
    </div>
  </section>
  <section class="section" aria-labelledby="for-h">
    <div class="wrap">
      <h2 id="for-h" class="h2">{headings.home_for}</h2>
      <Doors entries={all} />
    </div>
  </section>
</BaseLayout>
<style>
  .h2 { font-size: clamp(1.3rem, 1rem + 1.2vw, 1.8rem); margin: 0 0 1.25rem; }
  .story { max-width: 44ch; font-size: clamp(1.35rem, 1rem + 1.4vw, 2.1rem); line-height: 1.3; }
</style>
